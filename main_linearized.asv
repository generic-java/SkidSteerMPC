clear variables
close all
clc

addpath(genpath('C:\Users\geelhose\OneDrive - Rose-Hulman Institute of Technology\Desktop\Research\Model\YALMIP'));
addpath(genpath('C:\Users\geelhose\OneDrive - Rose-Hulman Institute of Technology\Desktop\Research\Model\OPTI-master'));


%% Define Physical Parameters
setup;

%% Pseudo-Linearization

% Initialize integration
t_s = 10e-3; % ms
t_f = 10;

linearize_reset = 1;
linearize_counter = 0;

t_gen = 0:t_s:t_f;
u_trajectory = [2 * ones(1, length(t_gen)); 1 * ones(1, length(t_gen))];

% Initialize simulation variables
curr_t = 0;
curr_x = zeros(6, 1);
curr_u = zeros(2, 1);

% Linearize
[A, B] = linearize(curr_t, curr_x, curr_u, params);
x_bar = curr_x;
u_bar = curr_u;

% Initialize storage variables
t_sim = [];
x_sim = [];

for i = 1:t_f/t_s
    tau_L = interp1(t_gen, u_trajectory(1, :), curr_t);
    tau_R = interp1(t_gen, u_trajectory(2, :), curr_t);
    curr_u = [tau_L; tau_R];

    if linearize_counter == linearize_reset
        [A, B] = linearize(curr_t, curr_x, curr_u, params);
        x_bar = curr_x;
        u_bar = curr_u;

        linearize_counter = 0;
    end
    linearize_counter = linearize_counter + 1;

    del_x_aug = [curr_x - x_bar; 1];
    del_u = curr_u - u_bar;
   
    % Solve the ODE numerically over the subinterval
    t_step = [t_gen(i), t_gen(i+1)];
    options = [];
    [t_sim_local, x_bar_sim_local] = ode23s(@(t, x) get_state_derivs_linear(t, x, del_u, A, B), t_step, del_x_aug, options);

    x_sim = [x_sim; x_bar_sim_local(:, 1:6) + x_bar'];
    curr_x  = x_sim(end, :)';

    t_sim = [t_sim; t_sim_local];
    curr_t = t_sim(end);
end

%% Full nonlinear model

% Initialize simulation variables
curr_t = 0;
curr_x = zeros(6, 1);

% Initialize storage variables
t_sim_nl = [];
x_sim_nl = [];

for i = 1:t_f/t_s
    tau_L = interp1(t_gen, u_trajectory(1, :), curr_t);
    tau_R = interp1(t_gen, u_trajectory(2, :), curr_t);
    curr_u = [tau_L; tau_R];
   
    % Solve the ODE numerically over the subinterval
    t_step = [t_gen(i), t_gen(i+1)];
    options = [];
    [t_sim_local, x_sim_local] = ode23s(@(t, x) get_state_derivs_nl(t, x, curr_u, params), t_step, curr_x, options);

    x_sim_nl = [x_sim_nl; x_sim_local];
    curr_x  = x_sim_nl(end, :)';

    t_sim_nl = [t_sim_nl; t_sim_local];
    curr_t = t_sim_nl(end);
end


%% Plot results
x = x_sim(:, 1);
y = x_sim(:, 2);
heading = x_sim(:, 3);

velx = x_sim(:, 4);
vely = x_sim(:, 5);
omega = x_sim(:, 6);

x_nl = x_sim_nl(:, 1);
y_nl = x_sim_nl(:, 2);
heading_nl = x_sim_nl(:, 3);

velx_nl = x_sim_nl(:, 4);
vely_nl = x_sim_nl(:, 5);
omega_nl = x_sim_nl(:, 6);

set(0, 'DefaultLineLineWidth', 2);

figure
plot(x, y);
hold on;
plot(x_nl, y_nl);
xlabel('$x$', 'Interpreter', 'latex', 'FontSize', 14)
ylabel('$y$', 'Interpreter', 'latex', 'FontSize', 14)
grid on;
axis equal;
legend(["Pseudo-linear", "Nonlinear"]);

figure
plot(t_sim, heading * 180 / pi);
hold on;
plot(t_sim_nl, heading_nl * 180 / pi);
xlabel('Time (s)', 'Interpreter', 'latex', 'FontSize', 14)
ylabel('Heading (deg)', 'Interpreter', 'latex', 'FontSize', 14)
grid on;
legend(["Pseudo-linear", "Nonlinear"]);

figure
plot(t_sim, velx);
hold on;
plot(t_sim_nl, velx_nl);
xlabel('Time (s)', 'Interpreter', 'latex', 'FontSize', 14)
ylabel('$V_x$ $(\frac{m}{s})$', 'Interpreter', 'latex', 'FontSize', 14)
grid on;
legend(["Pseudo-linear", "Nonlinear"]);

anim_car_traj(0.01, t_sim, x_sim, params.a, params.b, params.c)