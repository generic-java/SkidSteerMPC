function [opt_u, full_soln] = solve_MPC(Q, R, S, Np, Nc, t, index, x0, ref_traj, dist_traj, t_s, params, soln_last)

    % n_u is the number of control inputs; n is the number of states
    n_u = size(soln_last, 1);
    n = 6; % TODO: replace 6 with parameter
    
    % Define sdpvar matrix U for optimal input at each sample
    
    U = sdpvar(n_u, Nc, 'full'); % 'full' means the matrix is not symmetric.  We want a full set of decision vars
    assign(U, [soln_last(1:n_u, 2:Nc), soln_last(1:n_u, Nc)]); % Set the initial guess for U
    
    % Initialize the objective function at 0
    J = 0;
    
    % Initialize an empty constraint set
    constr = [];
    
    % Initialize state vector update each prediction step
    X_curr = x0;
    
    for j = 1:Np
    
        % Define the current reference vector
        %ref = preview_reference(t, Np, t_s, ref_traj); % Takes current time and generates next Np reference values
        %dist = preview_disturbance(t, Np, t_s, dist_traj); % Generate next Np disturbance values
        R_curr = ref_traj.Ref(:, index + j - 1);
    
        % Pull out current states and input from decision variable set 
        if j < Nc
            U_curr = U(:, j);
        else
            U_curr = U(:, Nc);
        end
    
        % Define the error
        E_curr = R_curr - X_curr;
    
        % Update the objection function J
        J = J + E_curr' * Q * E_curr + U_curr' * R * U_curr;
    
        % Apply all necessary constraints
        constr = [constr, U_curr(1) <= params.U_max];
        constr = [constr, U_curr(1) >= -params.U_max];
        constr = [constr, U_curr(1) <= params.U_max];
        constr = [constr, U_curr(1) >= -params.U_max];
        
    
        % Update state variables for next prediction step
        tic
        Xdot = get_state_derivs(t, X_curr, U_curr, params);
        X_curr = X_curr + t_s * Xdot; % We have to use Euler's method here since the system has not been linearized
        fprintf("Took %.2f s\n", toc);
 

        % Update time
        t = t + t_s;
         
    end
    
    % Set options and solve the problem

    options = sdpsettings('solver', 'ipopt', 'verbose', 0, 'usex0', 1, 'ipopt.max_iter', 10000);
    tic;
    solution = optimize(constr, J, options); % Create the optimizer object
    fprintf("Optimum took %.2f s\n", toc);

    flag = solution.problem;
    if flag == 0
        double(U)
        opt_u = double(U(:, 1));
        full_soln = double(U);
    else
        fprintf("Failed to find a feasible solution.  Received flag %.0f.\n", flag);
        opt_u = soln_last(:, 1);
        full_soln = soln_last; 
    end

end